# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing
android/key.properties
android/app/upload-keystore.jks
*.jks

# Graphify regenerable artifacts (keep GRAPH_REPORT.md, manifest.json, cost.json tracked)
graphify-out/cache/
graphify-out/graph.html
graphify-out/graph.json
graphify-out/.graphify_python
graphify-out/.graphify_*.json
# Dated snapshot folders (graphify-out/YYYY-MM-DD/) and backup copies
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
graphify-out/*.bak

# Per-machine Claude Code settings and agent worktrees
.claude/settings.local.json
.claude/worktrees/

# Local/FOSS dependency swaps (see packages/in_app_review_stub/)
pubspec_overrides.yaml
