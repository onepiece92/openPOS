<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- This app is offline by design (see CLAUDE.md). Star's StarXpand SDK
         ships INTERNET/ACCESS_NETWORK_STATE in its own manifest because it
         also supports LAN printers; we only ever use Bluetooth, so the
         permissions are stripped back out of the release binary. Debug builds
         keep INTERNET — the Flutter tool needs it for hot reload. -->
    <uses-permission android:name="android.permission.INTERNET"
        tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove"/>
</manifest>
